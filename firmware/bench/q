#!/usr/bin/env python3
"""bench/q — read-only query over runs/<id>/events.jsonl (for mr-engineer).

  bench/q runs                                  list runs (newest last)
  bench/q [--run ID|last] [filters] [output]    query one run (default: last)

Filters (AND-ed; comma lists are OR-ed; ev accepts a trailing * wildcard, e.g. bench.*):
  --ev a,b   --type X,Y   --state S   --where key=val (repeatable)   --since MS --until MS (on "t")
  --grep RE (regex on the JSON line)   --no-raw (drop {"ev":"raw"} lines)   --tail N (last N matches)
Output:
  default  compact JSON per event without "run"/"host_ts" (--full keeps them)
  --fields t,ev,...   only these keys     --table   aligned columns
  --count  count per ev of the matches    --all     no 200-line cap
"""
import argparse
import json
import os
import re
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
RUNS = os.environ.get("BENCH_RUNS", os.path.join(os.path.dirname(HERE), "runs"))
CAP = 200


def run_dirs():
    if not os.path.isdir(RUNS):
        return []
    out = []
    for d in sorted(os.listdir(RUNS)):
        p = os.path.join(RUNS, d)
        if d.startswith(".") or d == "last" or not os.path.isdir(p) or os.path.islink(p):
            continue
        if os.path.exists(os.path.join(p, "events.jsonl")) or os.path.exists(os.path.join(p, "meta.json")):
            out.append(d)
    return out


def resolve(run):
    if run in (None, "last"):
        link = os.path.join(RUNS, "last")
        if os.path.islink(link) or os.path.isdir(link):
            return os.path.basename(os.path.realpath(link))
        ds = run_dirs()
        if not ds:
            sys.exit("q: no runs")
        return max(ds, key=lambda d: os.path.getmtime(os.path.join(RUNS, d)))
    if not os.path.isdir(os.path.join(RUNS, run)):
        # allow unique prefix / substring
        m = [d for d in run_dirs() if run in d]
        if len(m) == 1:
            return m[0]
        sys.exit(f"q: run {run!r} not found" + (f" (ambiguous: {', '.join(m[:5])})" if m else ""))
    return run


def load_meta(run):
    try:
        with open(os.path.join(RUNS, run, "meta.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def list_runs():
    ds = run_dirs()
    if not ds:
        print("(no runs)")
        return
    print(f"{'run':<34} {'scenario':<10} {'build':<24} {'events':>7} {'err':>4}")
    for d in ds:
        meta = load_meta(d)
        n = err = 0
        try:
            with open(os.path.join(RUNS, d, "events.jsonl")) as f:
                for line in f:
                    n += 1
                    if '"err' in line or '"error' in line:
                        err += 1
        except OSError:
            pass
        print(f"{d:<34} {str(meta.get('scenario', '')):<10} {str(meta.get('build_id', '')):<24} {n:>7} {err:>4}")


def ev_match(ev, pats):
    for p in pats:
        if p.endswith("*") and ev.startswith(p[:-1]):
            return True
        if ev == p:
            return True
    return False


def fmt_val(v):
    return v if isinstance(v, str) else json.dumps(v, separators=(",", ":"))


def main(argv):
    if argv[:1] == ["runs"]:
        list_runs()
        return 0
    ap = argparse.ArgumentParser(prog="bench/q", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--run")
    ap.add_argument("--ev")
    ap.add_argument("--type")
    ap.add_argument("--state")
    ap.add_argument("--where", action="append", default=[])
    ap.add_argument("--since", type=float)
    ap.add_argument("--until", type=float)
    ap.add_argument("--grep")
    ap.add_argument("--no-raw", action="store_true")
    ap.add_argument("--tail", type=int)
    ap.add_argument("--fields")
    ap.add_argument("--table", action="store_true")
    ap.add_argument("--count", action="store_true")
    ap.add_argument("--full", action="store_true")
    ap.add_argument("--all", action="store_true")
    a = ap.parse_args(argv)

    run = resolve(a.run)
    path = os.path.join(RUNS, run, "events.jsonl")
    if not os.path.exists(path):
        sys.exit(f"q: {run} has no events.jsonl")
    evs = [e.strip() for e in a.ev.split(",")] if a.ev else None
    types = set(a.type.split(",")) if a.type else None
    states = set(a.state.split(",")) if a.state else None
    wheres = []
    for w in a.where:
        k, _, v = w.partition("=")
        wheres.append((k, v))
    rx = re.compile(a.grep) if a.grep else None
    fields = a.fields.split(",") if a.fields else None

    matches = []
    bad = 0
    with open(path) as f:
        for line in f:
            try:
                e = json.loads(line)
            except ValueError:
                bad += 1
                continue
            if not isinstance(e, dict):
                continue
            ev = str(e.get("ev", ""))
            if a.no_raw and ev == "raw":
                continue
            if evs and not ev_match(ev, evs):
                continue
            if types and str(e.get("type")) not in types:
                continue
            if states and str(e.get("state")) not in states:
                continue
            if any(fmt_val(e.get(k)) != v for k, v in wheres):
                continue
            if a.since is not None or a.until is not None:
                t = e.get("t")
                if not isinstance(t, (int, float)):
                    continue
                if a.since is not None and t < a.since:
                    continue
                if a.until is not None and t > a.until:
                    continue
            if rx and not rx.search(line):
                continue
            matches.append(e)
    if a.tail:
        matches = matches[-a.tail:]

    if a.count:
        counts = {}
        for e in matches:
            k = str(e.get("ev"))
            counts[k] = counts.get(k, 0) + 1
        for k, n in sorted(counts.items(), key=lambda kv: -kv[1]):
            print(f"{n:>7}  {k}")
        print(f"{len(matches):>7}  total  (run {run})")
        return 0

    def project(e):
        if fields:
            return {k: e.get(k) for k in fields}
        if a.full:
            return e
        return {k: v for k, v in e.items() if k not in ("run", "host_ts")}

    rows = [project(e) for e in matches]
    shown = rows if a.all else rows[:CAP]
    if a.table:
        cols = fields or ["t", "ev"]
        if not fields:
            for r in shown:
                for k in r:
                    if k not in cols:
                        cols.append(k)
            # without --fields, show t, ev, then the rest as k=v in one column
            head = ["t", "ev"]
            data = [[fmt_val(r.get("t", "")), fmt_val(r.get("ev", "")),
                     " ".join(f"{k}={fmt_val(v)}" for k, v in r.items() if k not in ("t", "ev"))] for r in shown]
            head.append("rest")
        else:
            head = cols
            data = [["" if r.get(k) is None else fmt_val(r.get(k)) for k in cols] for r in shown]
        widths = [max([len(h)] + [len(row[i]) for row in data]) for i, h in enumerate(head)]
        widths[-1] = 0  # last column unpadded
        print("  ".join(h.ljust(w) for h, w in zip(head, widths)).rstrip())
        for row in data:
            print("  ".join(c.ljust(w) for c, w in zip(row, widths)).rstrip())
    else:
        for r in shown:
            print(json.dumps(r, separators=(",", ":")))
    if len(rows) > len(shown):
        print(f"q: {len(rows) - len(shown)} more matches not shown (narrow the filter, --tail N, or --all)", file=sys.stderr)
    if bad:
        print(f"q: {bad} unparsable lines skipped", file=sys.stderr)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        sys.exit(0)
